# ─── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Endereço(s) do front-end autorizados pelo CORS (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# ─── PostgreSQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamerzone_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Banco usado SOMENTE pelos testes (é apagado e recriado a cada execução)
TEST_DB_NAME=gamerzone_test

# ─── Autenticação ──────────────────────────────────────────
# Obrigatório, mínimo 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GERE_UM_SEGREDO_E_COLE_AQUI
JWT_EXPIRES_IN=1d

# Tentativas de login/cadastro por IP a cada 15 minutos
AUTH_RATE_LIMIT=20
